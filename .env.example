# ============================================================
# PostgreSQL
# ============================================================

POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Local connection
POSTGRES_HOST=
POSTGRES_PORT=5433


# ============================================================
# Ingestion pipeline
# ============================================================

DESTINATION__POSTGRES__CREDENTIALS=postgresql://POSTGRES_USER:POSTGRES_PASSSWORD@localhost:5433/POSTGRES_DB #edit this


# ============================================================
# Gemini
# ============================================================

GEMINI_API_KEY= #Your GEMINI API KEY


# ============================================================
# Grafana
# ============================================================

GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=

MONITORING_JUDGE_SAMPLE_RATE=
MONITORING_JUDGE_MODEL=


# ============================================================
# FastAPI / Streamlit
# ============================================================
# FASTAPI_BASE_URL=http://localhost:8000 #for local hosting
FASTAPI_BASE_URL=  #substitute with Fast API URL

FLASHCARD_SECONDS_PER_CARD=8

STREAMLIT_PORT=8501

# Railway PostgreSQL
RAILWAY_POSTGRES_PASSWORD=xxxx  #This can be left blank for monitoring